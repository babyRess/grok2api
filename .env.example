GROK_BUILD_OAUTH_TOKEN=
GROK_BUILD_API_KEY=local-client-key
GROK_BUILD_API_PORT=8990

# Optional overrides:
# GROK_BUILD_ACCESS_TOKEN=
# GROK_AUTH_FILE=~/.grok/auth.json
# GROK_BUILD_DISABLE_CLI_AUTH=0
# GROK_BUILD_ACCOUNTS_FILE=./accounts.json
# For Docker Compose, the default mounted path is /data/accounts.json.
# GROK_BUILD_ACCOUNT_GROUP=default
# GROK_BUILD_ACCOUNT_ROTATION=balanced
# GROK_BUILD_CALLBACK_HOST=0.0.0.0
# GROK_BUILD_CALLBACK_PUBLIC_HOST=your-vps-domain.example
# GROK_BUILD_CALLBACK_PUBLIC_PORT=56122
# GROK_BUILD_BASE_URL=https://cli-chat-proxy.grok.com/v1

# === MODEL CONFIGURATION ===
# Comma-separated list of models to expose in /v1/models.
# - Reorders and filters from the built-in catalog
# - Unknown model names get smart defaults (reasoning=true, 1M context, image support)
# - Names containing "non-reasoning" are automatically marked as non-reasoning
# - reasoning.effort parameter now works correctly for manual models (this was previously broken)
#
# Examples:
# GROK_BUILD_MODELS=grok-4.20-0309-reasoning,grok-4.20-multi-agent-0309
# GROK_BUILD_MODELS=grok-4.5-experimental,grok-4.20-0309-reasoning,my-custom-model
# GROK_BUILD_MODELS=grok-build,grok-4.3
GROK_BUILD_MODELS=

# Fallback model when upstream rejects image input for the requested model
GROK_BUILD_IMAGE_MODEL=grok-build

# Optional server-side WebSearch:
# GROK_BUILD_WEB_SEARCH_PROVIDER=auto
# GROK_BUILD_WEB_SEARCH_ENDPOINT=
# GROK_BUILD_WEB_SEARCH_API_KEY=
# GROK_BUILD_WEB_SEARCH_AUTH_HEADER=authorization
# GROK_BUILD_WEB_SEARCH_MAX_RESULTS=5
# GROK_BUILD_BRAVE_SEARCH_API_KEY=
# GROK_BUILD_BRAVE_SEARCH_ENDPOINT=
