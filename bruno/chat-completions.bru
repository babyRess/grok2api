meta {
  name: Chat completions (OpenAI)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-api-key: {{apiKey}}
}

body:json {
  {
    "model": "{{model}}",
    "max_tokens": 256,
    "messages": [
      {
        "role": "user",
        "content": "Reply with a short haiku about APIs."
      }
    ]
  }
}

docs {
  # OpenAI Chat Completions
  Non-streaming OpenAI-compatible endpoint.
}
